 unsigned libfreehand::FHParser::_readRecordId(librevenge::RVNGInputStream *input)
 {
+  // I numeri alti occupano due parole: la prima (0xffff, 0xfffe, 0xfffd) indica il blocco da 64K.
+  // In origine era gestito solo 0xffff, e i file con più di 130.000 elementi non si potevano leggere.
   unsigned recid = readU16(input);
-  if (recid == 0xffff)
